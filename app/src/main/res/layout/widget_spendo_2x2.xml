<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/widget_red_dot"
            android:contentDescription="Status indicator" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="SPENDO"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_privacy_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="HIDE"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Spending & Balance Section -->
    <TextView
        android:id="@+id/widget_2x2_metric_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:text="SPENT TODAY"
        android:textColor="#666666"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_2x2_today_spend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:text="₹0.00"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_2x2_total_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="Bal: ₹96,100.50"
        android:textColor="#888888"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_2x2_accounts_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Indian • Kotak • KVB"
        android:textColor="#666666"
        android:textSize="9sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_2x2_action_add"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="+ Add"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_2x2_action_voice"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="🎙️ Voice"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
