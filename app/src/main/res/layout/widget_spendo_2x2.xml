<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Header Row: Brand & Streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/widget_red_dot"
            android:contentDescription="Status indicator" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="SPENDO"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="🔥 0 DAYS"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Spending & Daily Limit Section -->
    <TextView
        android:id="@+id/widget_2x2_metric_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:text="SPENT TODAY"
        android:textColor="#666666"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/widget_2x2_today_spend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:text="₹0.00"
        android:textColor="#FFFFFF"
        android:textSize="19sp" />

    <!-- Spending Limit Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_2x2_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#333333" />

    <TextView
        android:id="@+id/widget_2x2_limit_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="monospace"
        android:text="Set daily spending limit"
        android:textColor="#888888"
        android:textSize="9sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_2x2_action_add"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="+ Expense"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="4dp" />

        <TextView
            android:id="@+id/widget_2x2_action_voice"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="🎙️ Spendo AI"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="4dp" />
    </LinearLayout>
</LinearLayout>
