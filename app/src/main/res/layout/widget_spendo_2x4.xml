<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x4_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <!-- Top Header: Brand & Streak & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/widget_red_dot"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="SPENDO"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x4_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🔥 0 DAYS"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_2x4_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="SYNC"
            android:textColor="#888888"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- Today Spending Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:text="SPENT TODAY"
        android:textColor="#666666"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_2x4_today_spend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:text="₹0.00"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <!-- Daily Spending Limit Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_2x4_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#333333" />

    <TextView
        android:id="@+id/widget_2x4_limit_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:text="Set daily spending limit"
        android:textColor="#888888"
        android:textSize="9sp" />

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#222222"
        android:contentDescription="@null" />

    <!-- Recent Expenses Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:text="RECENT EXPENSES"
        android:textColor="#666666"
        android:textSize="8sp" />

    <!-- Empty State for Recent Expenses -->
    <TextView
        android:id="@+id/widget_2x4_recent_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="No recent expenses"
        android:textColor="#555555"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Recent Expense Item 1 -->
    <LinearLayout
        android:id="@+id/widget_2x4_recent_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_2x4_recent_1_merchant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:text="Merchant"
                android:textColor="#DDDDDD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_2x4_recent_1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Today"
                android:textColor="#666666"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_2x4_recent_1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="-₹0.00"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Recent Expense Item 2 -->
    <LinearLayout
        android:id="@+id/widget_2x4_recent_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_2x4_recent_2_merchant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:text="Merchant"
                android:textColor="#DDDDDD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_2x4_recent_2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Today"
                android:textColor="#666666"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_2x4_recent_2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="-₹0.00"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Recent Expense Item 3 -->
    <LinearLayout
        android:id="@+id/widget_2x4_recent_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_2x4_recent_3_merchant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:text="Merchant"
                android:textColor="#DDDDDD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_2x4_recent_3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Today"
                android:textColor="#666666"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_2x4_recent_3_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="-₹0.00"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_2x4_action_add"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="+ Expense"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/widget_2x4_action_voice"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="🎙️ Spendo AI"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>
</LinearLayout>
