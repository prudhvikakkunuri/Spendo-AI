<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/widget_red_dot"
            android:contentDescription="Status indicator" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="SPENDO • EXPENSE TRACKER"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_4x2_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="9dp"
            android:paddingVertical="2dp"
            android:text="🔥 0 DAYS"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_4x2_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="SYNC"
            android:textColor="#888888"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Main Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Today's Spending & Progress Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_4x2_metric_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:text="SPENT TODAY"
                android:textColor="#666666"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/widget_4x2_today_spend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:text="₹0.00"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <!-- Daily Spending Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_4x2_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#333333" />

            <TextView
                android:id="@+id/widget_4x2_limit_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:text="Set daily spending limit"
                android:textColor="#888888"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#222222"
            android:contentDescription="@null" />

        <!-- Right: Spending Streak Counter -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:text="RECORDING STREAK"
                android:textColor="#666666"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/widget_4x2_streak_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0 DAYS"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_4x2_streak_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:text="Log daily to build streak"
                android:textColor="#888888"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_4x2_action_add"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="+ Add Expense"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="6dp" />

        <TextView
            android:id="@+id/widget_4x2_action_ai"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="🎙️ Spendo AI"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="6dp" />
    </LinearLayout>
</LinearLayout>
